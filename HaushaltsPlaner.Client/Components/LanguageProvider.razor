@* Detects the browser language via navigator.language and updates I18nService.
   Renders nothing — purely a side-effect component. *@
@inject I18nService I18n
@inject IJSRuntime JS

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // navigator.language is only available after WASM is running in the browser
        var lang = await JS.InvokeAsync<string>("eval", "navigator.language");
        I18n.SetLanguageFromBrowser(lang);
    }
}
