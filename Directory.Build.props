<Project>
  <!--
    NuGet lock files (packages.lock.json next to every project): restore resolves exactly the
    recorded package graph, and in CI (GitHub Actions sets CI=true) as well as in the Docker
    builds the restore fails instead of silently updating the lock when a csproj and its lock
    file disagree (OpenSSF Scorecard Pinned-Dependencies). Dependabot updates the lock files
    together with the csproj versions; locally a plain `dotnet restore` refreshes them.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'HaushaltsPlaner.Client'">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <!--
    The Blazor WebAssembly client is the one project without a lock file: the WebAssembly SDK
    adds implicit package references (Microsoft.NET.Sdk.WebAssembly.Pack, ILLink.Tasks, the
    Internal.Assets pack) whose versions follow the installed SDK patch, so a lock written by
    one SDK fails locked-mode restore on the next patch, and pinning them explicitly breaks
    the linker on SDKs that bundle an older runtime. Its own package references are pinned
    to exact versions in the csproj; the Shared project it depends on is locked.
  -->
  <!--
    Warnings are errors, repo-wide: the build is warning-free today (2026-09-12 CI audit) and
    this keeps it that way - a new warning fails the PR instead of accumulating. Same setting
    as the other .NET repos; analyzer levels stay at the SDK defaults.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
